# Server. In production Strapi listens on localhost only; Apache is the public entry point.
HOST=0.0.0.0
PORT=1337
# Production: PUBLIC_URL=https://cms.example.gr and IS_PROXIED=true
PUBLIC_URL=
IS_PROXIED=false

# Secrets: generate each one with `openssl rand -base64 32` (APP_KEYS takes four, comma-separated)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database. Development uses SQLite; production uses MariaDB through the mysql client.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=raspedu
# DATABASE_USERNAME=raspedu
# DATABASE_PASSWORD=change-me

# Review notifications (optional). Without SMTP settings submissions still work, no email is sent.
REVIEW_NOTIFY_EMAIL=
STRAPI_ADMIN_URL=http://localhost:1337
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
